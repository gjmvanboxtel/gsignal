bA_scaled <- baA$b / nA
baA_scaled <- Arma(bA_scaled, baA$a)
bB_scaled <- baB$b * nA
baB_scaled <- Arma(bB_scaled, baB$a)

# The cascade’s overall gain is approximately preserved, while the
